# Copy to .env on the server (never commit .env)

# ---------- Domains ----------
# Public API (DNS A record -> server IP). Caddy gets the certificate for it.
API_DOMAIN=api.kubsei.com
# Frontend (Vercel). Used for CORS and for the post-login redirects.
FRONTEND_URL=https://kubsei.com
CORS_ALLOWED_ORIGINS=https://kubsei.com

# ---------- Security ----------
# Same value in every service. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=kubsei

# Google OAuth client (Google Cloud Console). Authorized redirect URI:
#   https://<API_DOMAIN>/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- MongoDB (Atlas) ----------
# One database per service
MONGODB_URI_USERS=mongodb+srv://user:pass@cluster.mongodb.net/kubsei_users
MONGODB_URI_EDITOR=mongodb+srv://user:pass@cluster.mongodb.net/kubsei_editor

# ---------- Image versions ----------
# "latest" = last build of main. Pin a commit SHA (ghcr.io/kubsei/<repo>:<sha>) to fix or roll back a version.
GATEWAY_TAG=latest
USERS_TAG=latest
EDITOR_TAG=latest
